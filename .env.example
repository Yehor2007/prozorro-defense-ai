# Copy this file to .env and fill in your own values.
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram: send /newbot and follow the prompts.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Optional overrides — defaults match rag_query.py
# CHROMA_PATH=chroma_db
# DB_PATH=data/prozorro.duckdb
# LLM_MODEL=qwen2.5:14b-instruct

# LLM provider — "ollama" (default, local/free, needs `ollama serve`) or "openai"
# LLM_PROVIDER=ollama
# OPENAI_API_KEY=sk-...       # required if LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini    # optional, this is already the default

# Only relevant when LLM_PROVIDER=ollama and Ollama ISN'T on localhost —
# e.g. a sibling Docker container (http://ollama:11434) or a separate GPU
# host (http://<gpu-host-ip>:11434). Read natively by the `ollama` python
# package itself, not by this project's own code.
# OLLAMA_HOST=http://localhost:11434

# Nightly incremental update job (see update_data.py) — cron-style, default 3:00 AM
# UPDATE_SCHEDULE_HOUR=3
# UPDATE_SCHEDULE_MINUTE=0

# If the data is older than this many hours at startup, run a catch-up
# sync immediately instead of waiting for the next scheduled time — a
# cron-style scheduler can silently miss a run if the process/host was
# paused (e.g. a laptop sleeping) past its misfire grace window, with no
# error logged. Confirmed live on Docker Desktop/macOS; a real always-on
# Linux server is far less likely to hit this, but the check is cheap
# insurance either way.
# UPDATE_STALE_THRESHOLD_HOURS=30
